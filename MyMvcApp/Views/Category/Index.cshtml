@model FUDTOs.PagedListViewModel<FUDTOs.CategoryDTO>

@{
    ViewData["Title"] = "Categories";
}

<div class="container">
    <h1>Categories</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New
        </a>
    </p>

    <form method="get" class="mb-3 d-flex gap-2 align-items-center">

        <input type="text" name="searchTerm" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name or description..." />

        <select name="sortField" class="form-select me-2">
            <option value="CategoryName" selected="@(ViewBag.CurrentSortField == "CategoryName" ? "selected" : null)">Category Name</option>
            <option value="CategoryDesciption" selected="@(ViewBag.CurrentSortField == "CategoryDesciption" ? "selected" : null)">Description</option>
        </select>

        <select name="isActive" class="form-select me-2">
            <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentIsActive) ? "selected" : null)">All</option>
            <option value="true" selected="@(ViewBag.CurrentIsActive == "true" ? "selected" : null)">Active</option>
            <option value="false" selected="@(ViewBag.CurrentIsActive == "false" ? "selected" : null)">Inactive</option>
        </select>

        <select name="sortDirection" class="form-select">
            <option value="asc" selected="@(ViewBag.CurrentSortDirection == "asc" ? "selected" : null)">Ascending</option>
            <option value="desc" selected="@(ViewBag.CurrentSortDirection == "desc" ? "selected" : null)">Descending</option>
        </select>

        <button type="submit" class="btn btn-primary">Search</button>
    </form>


    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Items[0].CategoryName)</th>
                    <th>@Html.DisplayNameFor(model => model.Items[0].CategoryDesciption)</th>
                    <th>@Html.DisplayNameFor(model => model.Items[0].IsActive)</th>
                    <th>@Html.DisplayNameFor(model => model.Items[0].ParentCategoryName)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.CategoryName</td>
                        <td>@item.CategoryDesciption</td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@item.ParentCategoryName</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-sortField="@ViewBag.CurrentSortField"
                   asp-route-sortDirection="@ViewBag.CurrentSortDirection">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize); i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchTerm="@ViewBag.CurrentSearch"
                       asp-route-sortField="@ViewBag.CurrentSortField"
                       asp-route-sortDirection="@ViewBag.CurrentSortDirection">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.PageNumber == (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize) ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-sortField="@ViewBag.CurrentSortField"
                   asp-route-sortDirection="@ViewBag.CurrentSortDirection">
                    Next
                </a>
            </li>
        </ul>
    </nav>
</div>

@section Styles {
    <style>
        .table th, .table td {
            vertical-align: middle;
        }
    </style>
}
